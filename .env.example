# Postgres
POSTGRES_USER=codesync
POSTGRES_PASSWORD=codesync
POSTGRES_DB=codesync

# GitHub OAuth App (create at https://github.com/settings/developers)
# Authorization callback URL must be: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Frontend URL the backend redirects back to after OAuth
FRONTEND_URL=http://localhost:5173

# JWT signing secret for session cookies - change this in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend build-time vars
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_YJS_WS_URL=ws://localhost:1234
